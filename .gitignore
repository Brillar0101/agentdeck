# --- OS / editor ---
.DS_Store
.history/
_restore_backup_*/

# --- KiCad per-user state & locks ---
*.kicad_prl
*~*.lck
~*.lck
*-backups/
.backups/

# --- scratch KiCad copies used for 3D exports ---
AgentDeck_v2sw.*
AgentDeck_v3sw.*

# --- autorouter intermediates (regenerate from the board) ---
*.dsn
*.ses
fr*.log
daemon/

# --- third-party tool (download separately) ---
# https://github.com/freerouting/freerouting/releases
# V1 generation/automation scripts and the autorouter jar are kept local only.
# V3 tools ARE tracked - anchor the V1 pattern to the repo root so it cannot
# swallow new files under v3/tools/.
/tools/
v3/tools/freerouting.jar
v3/tools/__pycache__/
v4/tools/freerouting.jar
v4/tools/__pycache__/
v3/hardware/.history/
v4/hardware/.history/

# --- derived 3D exports (regenerate: kicad-cli pcb export glb) ---
*.glb
*.blend1
*.blend2

# --- duplicate / superseded Blender scenes ---
3d/AgentDeck-assembled.blend
3d/AgentDeck-assembled-v1-saved.blend
3d/AgentDeck-v2.blend
3d/AgentDeck-v2-assembled-saved.blend
3d/AgentDeck-v3-assembled.blend
3d/.bak-*.blend

# --- third-party reference clone (github.com/jal-co/pi-codex-micro) ---
docs/reference/pi-codex-micro

# --- third-party product photographs (not ours to redistribute) ---
docs/reference/codex-micro-*.webp
docs/reference/codex-micro-*.png

# --- stray board backups from ad-hoc edits ---
.backups_*.kicad_pcb
*.kicad_pcb-bak

# --- autorouter logs anywhere ---
route*.log

# router scratch
v2/hardware/*.dsn
v2/hardware/*.ses
v2/hardware/_route_copy.*
v2/hardware/*-backups/
v2/hardware/fp-info-cache
